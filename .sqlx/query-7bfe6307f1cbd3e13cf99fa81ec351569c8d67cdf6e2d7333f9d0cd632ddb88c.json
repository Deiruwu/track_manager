  "query": "\n            SELECT\n                t.uuid,\n                t.title,\n                t.duration_seconds,\n                t.thumbnail_small,\n                t.thumbnail_large,\n                t.bpm,\n                t.camelot_key,\n                t.file_path,\n                t.added_at,\n                al.id   AS \"album_id?\",\n                al.name AS \"album_name?\"\n            FROM   tracks t\n            LEFT JOIN albums al ON al.id = t.album_id\n            WHERE  t.uuid = $1\n            ",
